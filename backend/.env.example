PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techflow
DB_USER=techflow
DB_PASSWORD=techflow123

# AI Agent (Ollama local — exposed via Cloudflare Tunnel for production)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Optional: shared secret to protect the tunnel endpoint
OLLAMA_SECRET=

# ── Enkripsi Source Code (AI Documentation Agent) ───────────────────────────
#
# RSA_PRIVATE_KEY  : RSA-2048 private key (PEM, base64-encoded)
#   Browser mengenkripsi AES key dengan RSA public key, hanya server
#   (yang punya private key ini) yang bisa mendekripsi.
#   ⚠️  JANGAN commit key ini ke Git!
#
# CODE_ENCRYPT_KEY : AES-256 key untuk enkripsi source_code di PostgreSQL (hex, 64 char)
#   Melindungi source_code jika terjadi DB breach.
#   ⚠️  JANGAN commit key ini ke Git!
#
# Generate kedua key sekaligus (jalankan sekali, simpan hasilnya):
#   cd backend
#   node -e "require('./src/services/cryptoService').generateAndPrintKeys()"
#
RSA_PRIVATE_KEY=
CODE_ENCRYPT_KEY=
